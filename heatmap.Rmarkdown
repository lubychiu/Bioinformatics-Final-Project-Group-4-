load libraries 
```{r}
library(dplyr)
library(tibble)
library(pheatmap)
library(tidyverse)
library(vegan)
library(ape)
```

import data
```{r}
setwd("~/Downloads")
sample189 <- read.delim("CNR0930189.bracken")
sample220 <- read.delim("CNR0930220.bracken")
sample221 <- read.delim("CNR0930221.bracken")
sample222 <- read.delim("CNR0930222.bracken")
```

create a counts table organized by name
1. create new dataframes with only the taxa names and read fractions 
```{r}
s189 <- sample189[, c("name", "fraction_total_reads")]
s220 <- sample220[, c("name", "fraction_total_reads")]
s221 <- sample221[, c("name", "fraction_total_reads")]
s222 <- sample222[, c("name", "fraction_total_reads")]
```

2. rename for easy merging
```{r}
colnames(s189) <- c("name", "189")
colnames(s220) <- c("name", "220")
colnames(s221) <- c("name", "221")
colnames(s222) <- c("name", "222")
```

3. merge dataframes
```{r}
fracs <- full_join(s189, s220, by = "name") %>%
  full_join(s221, by = "name") %>%
  full_join(s222, by = "name")
# turn NA to 0
fracs[is.na(fracs)] <- 0
```

heatmap
1. convert fracs into heatmap matrix
```{r}
matrix <- fracs %>%
  column_to_rownames("name") %>%
  as.matrix()

# convert matrix data to log form
mat_log <- log10(matrix + 1e-6)
```

2. keep only the most abundant taxa
```{r}
# sorts to show the most abundant species by row sums
top_taxa <- names(sort(rowSums(mat_log), decreasing = TRUE))[1:30]

# create new matrix including only the top taxa
mat_top <- mat_log[top_taxa, ]
```

3. create heatmap
```{r}
annotation <- data.frame(Group = c("Control", "CRC", "CRC", "Control"))
rownames(annotation) <- colnames(mat_top)

heatmap <- pheatmap(
  mat_top,
  annotation_col = annotation,
  cluster_rows = TRUE,
  cluster_cols = TRUE,
  scale = "row",
         fontsize_row = 8,
         fontsize_col = 10,
         main = "Taxonomic relative abundance"
)
```

significance testing
```{r}
# group assignment using matrix 
# 220 and 221 are CRC, 189 and 222 are controls
# order of columns is 189, 220, 221, 222
group <- c("Control", "CRC", "CRC", "Control")

# performing the test 
mat_top_p <- as.data.frame(mat_top)

mat_top_p$pvals <- apply(mat_top, 1, function(x) {
  wilcox.test(x[group == "CRC"], x[group == "Control"])$p.value
})

# adjusting p value 
mat_top_p$pvals_adj <- p.adjust(mat_top_p$pvals, method = "BH")
```

no taxa were found to be significantly enriched in either category

Beta Diversity plot: 
```{r}
mat_b <- fracs %>%
  column_to_rownames("name") %>%
  as.matrix()

# transpose so samples = rows
mat_b <- t(mat_b)   

# Compute Bray Curtis distance
dist_mat <- vegdist(mat_b, method = "bray")

# Compute PCoA (conversion to 2D plot)
pcoa <- pcoa(dist_mat)

# Create a plotting dataframe 
df <- data.frame(
  Sample = rownames(mat_b),
  PC1 = pcoa$vectors[,1],
  PC2 = pcoa$vectors[,2],
  Group = c("Control", "CRC", "CRC", "Control")
)

# Plot
ggplot(df, aes(x = PC1, y = PC2, color = Group, label = Sample)) +
  geom_point(size = 4) +
  geom_text(vjust = -1) +
  theme_minimal() +
  scale_color_manual(values = c("CRC" = "salmon", "Control" = "aquamarine2")) +
  theme(
  legend.text = element_text(size = 8),
  legend.title = element_text(size = 9),
  legend.spacing.y = unit(5, "cm")
) + 
  scale_y_continuous(expand = expansion(mult = c(0.1, 0.2))) + 
  labs(
    title = "Beta Diversity of CRC v. Normal Samples",
    x = "PC1",
    y = "PC2"
  )
```
